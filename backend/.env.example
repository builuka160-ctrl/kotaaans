# Port the server listens on
PORT=4000

# production also turns on the Secure flag for the admin cookie
NODE_ENV=development

# Password for the admin panel (change this!)
ADMIN_PASSWORD=change-me

# Signs the admin session cookie. Set a long random string in production:
# without it a random secret is generated at boot, so everyone signed in is
# signed out on restart, and several instances never accept each other's
# cookies. Required on serverless hosting (Netlify).
SESSION_SECRET=

# Set to 1 if the site is served over HTTPS, so the admin session cookie
# gets the Secure flag. Leave at 0 for local http:// testing.
COOKIE_SECURE=0

# Set to 1 if this runs behind a reverse proxy / hosting platform
# (Render, Railway, Fly.io, nginx...) so client IPs are read from
# X-Forwarded-For correctly. Needed for IP banning to work.
TRUST_PROXY=0

# --- Storage option 1: Google Sheets through Apps Script (recommended) ---
# 1. Create a new Google Sheet.
# 2. Extensions -> Apps Script -> paste the contents of
#    google-apps-script/Code.gs from this folder.
# 3. In Project Settings -> Script Properties, add a property named
#    API_TOKEN with any long random value (this is GOOGLE_SHEETS_TOKEN below).
# 4. Run the `setup` function once, then Deploy -> New deployment -> "Web app".
#    Execute as: Me. Who has access: Anyone.
# 5. Copy the "Web app URL" (it ends in /exec) and paste it below.
#
# If neither storage option is configured, the backend stores everything in a
# local JSON file (backend/data/db.json) instead, so you can develop and test
# without Google Sheets set up yet. That file is for development only —
# serverless hosts and containers wipe it.
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_TOKEN=
# GOOGLE_APPS_SCRIPT_URL and APPS_SCRIPT_SECRET are accepted as aliases.

# --- Storage option 2: Google Sheets API with a service account ----------
# Advanced alternative for setups that already have a Google Cloud service
# account: enable the Sheets API, share the spreadsheet with the service
# account as Editor, then set the spreadsheet ID and either the key JSON
# itself or a path to the key file.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Web Push (optional) -------------------------------------------------
# Generate a key pair once with: npx web-push generate-vapid-keys
# Without these the site still asks for notification permission, it just
# cannot deliver notifications while the tab is closed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kotans.barber@gmail.com

# Where the development JSON store is kept (defaults to backend/data/db.json)
# LOCAL_DB_PATH=
