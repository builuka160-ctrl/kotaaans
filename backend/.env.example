# Port the server listens on
PORT=4000

# Password for the admin panel (change this!)
ADMIN_PASSWORD=change-me

# Set to 1 if the site is served over HTTPS, so the admin session cookie
# gets the Secure flag. Leave at 0 for local http:// testing.
COOKIE_SECURE=0

# Set to 1 if this runs behind a reverse proxy / hosting platform
# (Render, Railway, Fly.io, nginx...) so client IPs are read from
# X-Forwarded-For correctly. Needed for IP banning to work.
TRUST_PROXY=0

# --- Google Sheets connection -------------------------------------------
# 1. Create a new Google Sheet.
# 2. Extensions -> Apps Script -> paste the contents of
#    google-apps-script/Code.gs from this folder.
# 3. In Project Settings -> Script Properties, add a property named
#    API_TOKEN with any long random value (this is GOOGLE_SHEETS_TOKEN below).
# 4. Deploy -> New deployment -> type "Web app".
#    Execute as: Me. Who has access: Anyone.
# 5. Copy the "Web app URL" it gives you and paste it below.
#
# If GOOGLE_SHEETS_URL is left empty, the backend stores everything in a
# local JSON file (backend/data/db.json) instead, so you can develop and
# test without Google Sheets set up yet.
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_TOKEN=
